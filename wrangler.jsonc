// Konfigurace Cloudflare Pages projektu. Je zdrojem pravdy pro bindingy —
// jakmile soubor existuje, Pages je čte odtud a v dashboardu je nelze editovat.
// Platí i pro `wrangler pages dev` a pro migrace přes `wrangler d1 execute`.
// Secrets (Gmail, Resend) se nastavují výhradně v dashboardu.
//
// Lokální vývoj (`npm run dev`) používá wrangler.dev.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-sokol-kramolna",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-05-30",

  // Produkce (větev main)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sokol-kramolna-db",
      "database_id": "ad8dfe4a-6c05-4f89-8389-22c04b611bd3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sokol-kramolna-media"
    }
  ],

  // Preview (všechny ostatní větve) — dřívější staging prostředí.
  // Pozor: bindingy se do prostředí nedědí, proto se tu vypisují celé.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sokol-kramolna-db-staging",
          "database_id": "99e1b9f0-6dd8-4a5f-b7d4-559ff9b116b4"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "sokol-kramolna-media-staging"
        }
      ]
    }
  }
}
